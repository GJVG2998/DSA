#include <stdio.h>
#include <stdlib.h>
struct node{
    int val;
    struct node *left;
    struct node *right;
};
struct node* create(int v){
    struct node* newnode=(struct node*)malloc(sizeof(struct node));
    newnode->val=v;
    newnode->left=NULL;
    newnode->right=NULL;
    return newnode;
}
struct node* insert(struct node* root,int v){
    if(root==NULL)
        return create(v);
    if(v<root->val)
	    root->left=insert(root->left,v);
    else if(v>root->val)
        root->right=insert(root->right,v);
    return root;
}
struct node* findmin(struct node* root){
    struct node* curr=root;
    while(curr!=NULL && curr->left!=NULL)
        curr=curr->left;
    return curr;
}
struct node* delete(struct node* root,int v){
    if(root==NULL)
        return root;
    if(v<root->val)
        root->left=delete(root->left,v);
    else if(v>root->val) 
        root->right=delete(root->right,v);
    else{
        if(root->left==NULL){
            struct node* temp=root->right;
            free(root);
            return temp;
        }
        else if(root->right==NULL){
            struct node* temp=root->left;
            free(root);
            return temp;
        }
        else{
            struct node* temp=findmin(root->right);
            root->val=temp->val;
            root->right=delete(root->right,temp->val);
        }
    }
    return root;
}
void inorder(struct node* root){
    if(root!=NULL){
        inorder(root->left);
        printf("%d ",root->val);
        inorder(root->right);
    }
}
int main(){
    struct node* root=NULL;
    root=insert(root,4);
    root=insert(root,5);
    root=insert(root,7);
    root=insert(root,2);
    root=insert(root,9);
    root=insert(root,6);
    root=insert(root,8);
    printf("inorder traversal:\n");
    inorder(root);
    printf("\n");
    root=delete(root,7);
    root=delete(root,6);
    printf("inorder traversal:\n");
    inorder(root);
    printf("\n");
    return 0;
}
