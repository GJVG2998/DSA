#include <stdio.h>
typedef struct{
    int n;
    char source;
    char auxiliary;
    char destination;
    int state;
}Frame;
void towerOfHanoi(int n,char source,char auxiliary,char destination){
    Frame stack[100];
    int top=-1;
    stack[++top]=(Frame){n,source,auxiliary,destination,0};
    while(top>=0){
        Frame *current=&stack[top];
        if(current->n==1){
            printf("Move disk 1 from %c to %c\n",current->source,current->destination);
            top--; 
            continue;
        }
        if(current->state==0){
            current->state=1;
            stack[++top]=(Frame){current->n - 1,current->source,current->destination,current->auxiliary,0};
        }
        else if(current->state==1){
            printf("Move disk %d from %c to %c\n",current->n,current->source,current->destination);
            current->state=2;
            stack[++top]=(Frame){current->n-1,current->auxiliary,current->source,current->destination,0};
        }
        else{
            top--;
        }
    }
}
int main(){
    int n;
    printf("Enter number of disks: ");
    scanf("%d",&n);
    towerOfHanoi(n,'A','B','C');
    return 0;
}
