#include<stdio.h>
void merge(int arr[],int i1,int j1,int i2,int j2);
void mergeSort(int arr[],int low,int high){
	int mid=(low+high)/2;
	if(low<high){
	   mergeSort(arr,low,mid);
	   mergeSort(arr,mid+1,high);
	   merge(arr,low,mid,mid+1,high);
	}
}
void merge(int arr[],int i1,int j1,int i2,int j2){
	int i=i1;
	int j=i2;
	int k=0;
	int temp[50];
	while(i<=j1 && j<=j2){
		  if(arr[i]<arr[j])
		     temp[k++]=arr[i++];
		  else
		     temp[k++]=arr[j++];
	}
	while(i<=j1){
		  temp[k++]=arr[i++];
	}
	while(j<=j2){
		  temp[k++]=arr[j++];
	}
	for(i=i1,k=0;i<=j2;i++,k++)
        arr[i]=temp[k];
}
int main(){
	int n,i;
	int arr[50];
	printf("enter no. of elements:");
	scanf("%d",&n);
	printf("enter elements:\n");
	for(i=0;i<n;i++)
	    scanf("%d",&arr[i]);
	mergeSort(arr,0,n-1);
	printf("sorted elements:\n");
	for(i=0;i<n;i++)
	    printf("%d\t",arr[i]);
	printf("\n");
	return 0;
}
