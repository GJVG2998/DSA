#include <iostream>
#include <climits>
using namespace std;
int main(){
    int V;
    cout<<"Enter number of vertices: ";
    cin>>V;
    int graph[100][100];
    cout<<"Enter the adjacency matrix:\n";
    for(int i=0;i<V;i++){
        for(int j=0;j<V;j++){
            cin>>graph[i][j];
        }
    }
    int key[100];       
    int parent[100];    
    bool visited[100];  
    for(int i=0;i<V;i++){
        key[i]=INT_MAX;
        parent[i]=-1;
        visited[i]=false;
    }
    key[0]=0;
    for(int count=0;count<V;count++){
        int u=-1;
        int minValue=INT_MAX;
        for(int i=0;i<V;i++){
            if(!visited[i] && key[i]<minValue){
                minValue=key[i];
                u=i;
            }
        }
        visited[u]=true;
        for(int v=0;v<V;v++){
            if(graph[u][v]!=0 && !visited[v] && graph[u][v]<key[v]){
                key[v]=graph[u][v];
                parent[v]=u;
            }
        }
    }
    int totalWeight=0;
    cout<<"\nEdges in Minimum Spanning Tree:\n";
    for(int i=1;i<V;i++){
        cout<<parent[i]<<" - "<<i<<" : "<<graph[i][parent[i]]<<endl;
        totalWeight+=graph[i][parent[i]];
    }
    cout<<"\nMinimum Cost= "<<totalWeight<<endl;
    return 0;
}
