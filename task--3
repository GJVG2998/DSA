#include<stdio.h>
#include<stdlib.h>
struct Node {
	int data;
	struct Node* next;
};
struct Node* top=NULL;
void push(int value){
	struct Node* newNode=(struct Node*)malloc(sizeof(struct Node));
	newNode->data=value;
	newNode->next=top;
	top=newNode;
}
void pop(){
	if(top==NULL){
	  printf("stack underflow\n");
	  return;
    }
	top=top->next;
}
void display(){
	struct Node* temp=top;
	while(temp!=NULL){
		printf("%d\t",temp->data);
		temp=temp->next;
	}
	printf("\n");
}
int main(){
	pop();
	push(12);
	push(4);
	push(6);
	push(8);
	display();
	push(10);
	push(14);
	display();
	pop();
	display();
	return 0;
}
