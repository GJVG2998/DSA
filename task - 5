#include <stdio.h>
#define N 10
void bucketSort(float arr[],int n){
    float buckets[N][N];
    int count[N]={0};
    int i,j;
    for(i=0;i<n;i++){
        int index=(int)(arr[i]*N);
        buckets[index][count[index]++]=arr[i];
    }
    for(i=0;i<N;i++){
        for(j=1;j<count[i];j++){
            float key=buckets[i][j];
            int k=j-1;
            while(k>=0 && buckets[i][k]>key){
                buckets[i][k+1]=buckets[i][k];
                k--;
            }
            buckets[i][k + 1]=key;
        }
    }
    int index=0;
    for (i=0;i<N;i++){
        for(j=0;j<count[i];j++)
            arr[index++]=buckets[i][j];
    }
}
int main(){
    float arr[]={0.42,0.32,0.23,0.52,0.25,0.47,0.51,0.12,0.75,0.33};
    int n=sizeof(arr)/sizeof(arr[0]);
    int i;
    bucketSort(arr,n);
    printf("Sorted array:\n");
    for (i=0;i<n;i++)
        printf("%.2f\t",arr[i]);
    return 0;
}
