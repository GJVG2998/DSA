#include<stdio.h>
int power(int x,int n){
	if(x==0)
	  return 1;
	int ans=1;
	while(n>0){
		if(n%2==1){
			ans=ans*x;
			n=n-1;
		}
		else{
		    n=n/2;
		    x=x*x;
	    }
	}
	return ans;
}
 int main(){
 	int x,n,sum=0;
 	printf("enter the value of x:");
 	scanf("%d",&x);
 	printf("enter the no. of terms:");
 	scanf("%d",&n);
 	if(x==1)
 	  sum=n;
 	else
 	  sum=(power(x,n)-1)/(x-1);
 	printf("sum=%d\n",sum);
 	return 0;
 }
